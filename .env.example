# Notion API credentials
# https://www.notion.so/my-integrations で取得
NOTION_API_KEY=

# Notion database ID (URLの末尾の32文字)
NOTION_DATABASE_ID=

# Gmail address and app password
# https://myaccount.google.com/apppasswords で取得
MAIL_ADDRESS=
GMAIL_PASSWORD=

# Log level: DEBUG or INFO (default: DEBUG)
LOG_LEVEL=DEBUG
